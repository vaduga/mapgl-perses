{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "DOM",
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "noImplicitAny": false,
    "useDefineForClassFields": false,
    "customConditions": [
      "development"
    ],
    "preserveSymlinks": true
  },
  "include": [
    "src",
    "perses-adapter/src",
    "rsbuild.config.ts",
    "vitest.config.ts"
  ]
}
